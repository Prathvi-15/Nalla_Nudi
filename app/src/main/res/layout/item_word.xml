<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvSubjectTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Science"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#9C27B0"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvEnglishWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Photosynthesis"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#311B92"/>

        <TextView
            android:id="@+id/tvKannadaWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ದ್ಯುತಿಸಂಶ್ಲೇಷಣೆ"
            android:textSize="16sp"
            android:textColor="#6A1B9A"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvKannadaExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ಸಸ್ಯಗಳು ಸೂರ್ಯನ ಬೆಳಕನ್ನು ಬಳಸಿ ಆಹಾರ ತಯಾರಿಸುವ ಪ್ರಕ್ರಿಯೆ"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp"/>

        <!-- Three buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnPronounce"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:text="🔊 English"
                android:textSize="10sp"
                android:backgroundTint="#EDE7F6"
                android:textColor="#4A148C"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnPronounceKannada"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:text="🔊 ಕನ್ನಡ"
                android:textSize="10sp"
                android:backgroundTint="#EDE7F6"
                android:textColor="#4A148C"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:text="⭐ Save"
                android:textSize="10sp"
                android:backgroundTint="#4A148C"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>